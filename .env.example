# Backend
DATABASE_URL=sqlite:///./freelanceflow.db
STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
# Deployed escrow contract ID (public identifier, not a secret)
SOROBAN_ESCROW_CONTRACT_ID=CA5FBQ4VEJ4ZXGVDVMAGRP6JKEB7AGUUG5ZR3NYSNG3A6XFUUVCL37CI
NEXT_PUBLIC_ESCROW_CONTRACT_ID=CA5FBQ4VEJ4ZXGVDVMAGRP6JKEB7AGUUG5ZR3NYSNG3A6XFUUVCL37CI
NEXT_PUBLIC_SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
# Shared rate limiting: database (recommended) or memory (local only)
RATE_LIMIT_BACKEND=database
RATE_LIMIT_ENABLED=true
RATE_LIMIT_FAIL_OPEN=true
# Account recovery (no email provider is bundled)
EMAIL_DELIVERY_CONFIGURED=false
# NEVER enable in production: returns verification/reset tokens in API responses
EMAIL_DEV_MODE=false

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000

# PostgreSQL via Docker
POSTGRES_DB=freelanceflow
POSTGRES_USER=freelanceflow
POSTGRES_PASSWORD=replace-with-a-long-random-secret
NEXT_PUBLIC_API_URL=http://localhost:8000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
